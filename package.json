{
  "name": "nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "npm run build:css && npm run build:clerk-proxy && npm run build:client && npm run build:auth && node index.js",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/tailwind.css --minify",
    "build:clerk-proxy": "esbuild server/middlewares/clerkProxyMiddleware.ts --bundle --platform=node --format=cjs --external:http-proxy-middleware --outfile=.cache/clerkProxyMiddleware.cjs",
    "build:client": "esbuild src/site.js --bundle --platform=browser --format=esm --target=es2020 --outfile=public/site.js",
    "build:auth": "esbuild src/auth.jsx --bundle --platform=browser --format=esm --target=es2020 --outfile=public/auth-app.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/clerk-js": "^6.37.0",
    "@clerk/express": "^2.1.75",
    "@clerk/react": "^6.17.5",
    "@clerk/shared": "^4.38.0",
    "@clerk/themes": "^2.4.57",
    "@types/node": "^22.13.11",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "http-proxy-middleware": "^4.2.0",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.0",
    "multer": "^1.4.4",
    "multer-gridfs-storage": "^5.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.17"
  }
}
